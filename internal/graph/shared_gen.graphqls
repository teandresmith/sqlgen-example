scalar Decimal
scalar JSON
scalar Time
scalar UUID

enum AttachmentEntityType {
  TASK
  COMMENT
}

enum CycleStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum DependencyType {
  BLOCKS
  RELATES_TO
  DUPLICATES
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum SsoProvider {
  SAML
  OIDC
  GOOGLE
  OKTA
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELED
}

type Query
type Mutation

type PageInfo {
  hasNextPage:     Boolean!
  hasPreviousPage: Boolean!
  startCursor:     String
  endCursor:       String
}

enum SortDirection {
  ASC
  DESC
}

input StringComparator {
  eq:         String
  neq:        String
  gt:         String
  gte:        String
  lt:         String
  lte:        String
  contains:   String
  startsWith: String
  endsWith:   String
  like:       String
  nlike:      String
  in:         [String!]
  nin:        [String!]
}

input NullableStringComparator {
  eq:         String
  neq:        String
  gt:         String
  gte:        String
  lt:         String
  lte:        String
  contains:   String
  startsWith: String
  endsWith:   String
  like:       String
  nlike:      String
  in:         [String!]
  nin:        [String!]
  isNull:     Boolean
}

input NumericComparator {
  eq:       Float
  neq:      Float
  gt:       Float
  gte:      Float
  lt:       Float
  lte:      Float
  in:       [Float!]
  nin:      [Float!]
  between:  NumericRange
  nbetween: NumericRange
}

input NumericRange {
  from: Float!
  to:   Float!
}

input BooleanComparator {
  eq:  Boolean
  neq: Boolean
}

input TimeComparator {
  eq:       Time
  neq:      Time
  gt:       Time
  gte:      Time
  lt:       Time
  lte:      Time
  in:       [Time!]
  nin:      [Time!]
  between:  TimeRange
  nbetween: TimeRange
}

input TimeRange {
  from: Time!
  to:   Time!
}

input NullableTimeComparator {
  eq:       Time
  neq:      Time
  gt:       Time
  gte:      Time
  lt:       Time
  lte:      Time
  in:       [Time!]
  nin:      [Time!]
  between:  TimeRange
  nbetween: TimeRange
  isNull:   Boolean
}

input IDComparator {
  eq:  ID
  neq: ID
  gt:  ID
  gte: ID
  lt:  ID
  lte: ID
  in:  [ID!]
  nin: [ID!]
}

input NullableIDComparator {
  eq:     ID
  neq:    ID
  gt:     ID
  gte:    ID
  lt:     ID
  lte:    ID
  in:     [ID!]
  nin:    [ID!]
  isNull: Boolean
}

input DecimalComparator {
  eq:  Decimal
  neq: Decimal
  gt:  Decimal
  gte: Decimal
  lt:  Decimal
  lte: Decimal
  in:  [Decimal!]
  nin: [Decimal!]
}

input JSONBComparator {
  hasKey:      String
  hasAnyKey:   [String!]
  hasAllKeys:  [String!]
  contains:    JSON
  containedBy: JSON
  pathExists:  String
}

input AttachmentEntityTypeComparator {
  eq:  AttachmentEntityType
  neq: AttachmentEntityType
  in:  [AttachmentEntityType!]
  nin: [AttachmentEntityType!]
}

input CycleStatusComparator {
  eq:  CycleStatus
  neq: CycleStatus
  in:  [CycleStatus!]
  nin: [CycleStatus!]
}

input DependencyTypeComparator {
  eq:  DependencyType
  neq: DependencyType
  in:  [DependencyType!]
  nin: [DependencyType!]
}

input InvitationStatusComparator {
  eq:  InvitationStatus
  neq: InvitationStatus
  in:  [InvitationStatus!]
  nin: [InvitationStatus!]
}

input MembershipRoleComparator {
  eq:  MembershipRole
  neq: MembershipRole
  in:  [MembershipRole!]
  nin: [MembershipRole!]
}

input SsoProviderComparator {
  eq:  SsoProvider
  neq: SsoProvider
  in:  [SsoProvider!]
  nin: [SsoProvider!]
}

input StringSliceComparator {
  containsAny: [String!]
  containsAll: [String!]
  containedBy: [String!]
  isEmpty:     Boolean
}

input TaskPriorityComparator {
  eq:  TaskPriority
  neq: TaskPriority
  in:  [TaskPriority!]
  nin: [TaskPriority!]
}

input TaskStatusComparator {
  eq:  TaskStatus
  neq: TaskStatus
  in:  [TaskStatus!]
  nin: [TaskStatus!]
}
