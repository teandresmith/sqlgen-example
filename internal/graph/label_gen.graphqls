"""
A workspace-scoped tag applied to tasks
"""
type Label {
  "Unique label identifier"
  id: UUID!
  "Owning workspace (tenant column)"
  workspaceID: UUID!
  "Label text (unique per workspace)"
  name: String!
  "Hex display color"
  color: String!
  "Row creation timestamp"
  createdAt: Time!
  "many-to-many relationship with the tasks table."
  tasks: [Task!]!
}

type LabelConnection {
  edges:      [LabelEdge!]!
  pageInfo:   PageInfo!
  totalCount: Int!
}

type LabelEdge {
  node:   Label!
  cursor: String!
}

type LabelListResult {
  items:      [Label!]!
  totalCount: Int!
  offset:     Int!
  limit:      Int!
  hasMore:    Boolean!
}

input LabelFilter {
  workspaceID: IDComparator
  name: StringComparator
  color: StringComparator
  createdAt: TimeComparator
  tasks: TaskFilter
  and: [LabelFilter!]
  or:  [LabelFilter!]
}

enum LabelSortField {
  ID
  WORKSPACE_ID
  NAME
  COLOR
  CREATED_AT
}

input LabelSort {
  field:     LabelSortField!
  direction: SortDirection!
}
input CreateLabelInput {
  workspaceID: UUID!
  name: String!
  color: String!
  createdAt: Time!
}
input UpdateLabelInput {
  name: String
  color: String
  createdAt: Time
}

extend type Query {
  label(id: UUID!): Label
  "Cursor-paginated; ordering is driven by cursor_keys to preserve keyset semantics — pass `sort` to labelList instead."
  labels(filter: LabelFilter, first: Int, after: String, last: Int, before: String): LabelConnection!
  labelList(filter: LabelFilter, sort: [LabelSort!], limit: Int, offset: Int): LabelListResult!
}

extend type Mutation {
  createLabel(input: CreateLabelInput!): Label!
  createLabels(inputs: [CreateLabelInput!]!): [Label!]!
  updateLabel(id: UUID!, input: UpdateLabelInput!): Label!
  updateLabels(filter: LabelFilter!, input: UpdateLabelInput!): [Label!]!
  upsertLabel(input: CreateLabelInput!): Label!
  deleteLabel(id: UUID!): Boolean!
}
